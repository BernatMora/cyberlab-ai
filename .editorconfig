# .editorconfig — convencions d'edició coherents a tot el repo
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false  # el markdown tolera espais al final (dues espais = <br>)

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[*.bat]
end_of_line = crlf
